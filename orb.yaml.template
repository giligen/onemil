# ORB (Opening Range Breakout) Strategy Configuration
# Third strategy, runs alongside bull flag + MACD wave in main.py process.
# Fires at 9:35 ET on gap-up movers breaking the first 5-minute range high.
#
# Validated Jan'25-Apr'26 through defended pipeline (static_lock_1R exit —
# what this engine actually ships with):
#   Full-timeline P&L: $+342,565
#   Full-timeline DD:  $-18,126   (trough 2025-11-13)
#   Calmar:            18.90x
#   Daily WR:          56.6%
#   Trades:            1,001 on 309 trading days
#   Negative months:   1 (Aug 2025, $-9,288)
#   Source: study_orb_pipeline_static_lock.py (authoritative),
#           show_q1_2025_static_lock.py, study_orb_loser_dive_static_lock.py
# NOTE: Earlier headline numbers ($239,853 / Calmar 15.68x) came from scripts
# that read orb_features_*.csv pnl directly — that CSV uses fixed +2R/-1R
# exits, NOT static_lock_1R. Those scripts are marked with warning headers.

strategy:
  name: orb
  enabled: true           # MASTER KILL SWITCH. Restart to flip.

# Universe — BT-parity criteria (study_orb_broad.py::load_broad_universe):
# gap >= 5%, prev-day volume >= 500K, price $3-30.
# Applied via build_orb_universe_from_snapshots() on scanner-qualified candidates.
# Strategy: scanner provides a broad pool (its own bull-flag criteria), then ORB
# filters that pool down via its own criteria. Matches BT universe closely.
universe:
  source: alpaca_snapshots  # 'alpaca_snapshots' (BT-parity) | 'scanner_qualified' (legacy)
  min_price: 3.0
  max_price: 30.0
  min_gap_pct: 5.0
  min_prev_volume: 500000

# Entry — 5-min opening range breakout.
# Trigger mode: TOUCH (bar high > range_high). Production = pre-placed stop-limit buy.
entry:
  range_minutes: 5          # 9:30-9:35 ET range window
  entry_mode: touch         # 'touch' | 'close_above'
  entry_slip_bps: 30        # calibrated from bull flag live data; measured in Phase 1
  time_stop_minutes: 60     # cancel unfilled buy-stop at 10:35 ET (per-order clock, from submit)
  max_spread_bps: 150       # skip entry + telegram warning if (ask-bid)/price > 150bps
  stop_limit_buffer_bps: 30 # stop-limit buy: limit = range_high × (1 + buffer/10000)
  # BT picks top-K once at 9:35 ET. Live allows a short window for late bar-
  # stream / backfill / candidates arriving slowly, then HARD-BLOCKS new
  # submissions. Fix shipped 2026-04-20 after QBTZ/BATL slipped through at
  # 12:30 / 1:11 PM ET. Raise to be more permissive with late arrivals, or
  # lower toward "09:45" for strict BT-exact behavior.
  last_entry_submit_time_et: "10:00"

# Composite filter — 7-feature signed z-score, threshold >= 0.
# Params baked from H1 2025 TRAIN fit (1090 trades). Refit quarterly via study_orb_refit.py.
filter:
  threshold: 0.0
  # Drop Q1 (bottom quintile) candidates at ranking time. Q1 is TRAIN-positive
  # but OOS-negative (VAL -$5.1K, HOQ1+ -$3.4K) — classic overfit. Reduces
  # trade frequency from 3.25 → 2.96/day with no DD impact. Note: slots do
  # NOT refill with higher-quintile candidates because Q1 is last-priority
  # in ranking_order — removing it never unblocks higher-Q via dedup
  # (verified by check_q1_refill_potential.py). The filter is pure subtraction.
  # BT lift: +$8,556 combined OOS (VAL +$5,151, HOQ1+ +$3,405). See
  # study_orb_q1q2_filter.py for walk-forward validation.
  skip_q1: true
  # Touch-and-go filter (Rule M + Rule D). Default-on, walk-forward validated
  # on Jan'25-May'26 (924 trades, 8/11 OOS months helped, +$27K OOS,
  # +$44K full-timeline lift, WR 47.8% → 52.1%, cumulative max DD -16%).
  # Shared module: trading/orb_touchgo_filter.py (imported by both BT
  # study_orb_pipeline_static_lock.py and live trading/orb_engine.py for parity).
  #
  # Rule M: at the close of the breakout bar (the bar that triggered our
  # stop-limit BUY), if its close sat in the bottom half of its high-low
  # range (close_pos < threshold), exit at next bar open. Catches "touch
  # and go" failed breakouts where buyers couldn't hold the high.
  #
  # Rule D: at the close of the first post-entry bar, if the bar's low
  # reverted >= revert_R below entry (where R = range_high - range_low),
  # exit at entry + exit_R * range_size. Catches fast reversal patterns.
  #
  # Rollback: flip `enabled: false` and restart onemil-trader.
  # Per-rule disable: flip rule_m.enabled or rule_d.enabled.
  # Env-var override for BT research: ORB_TOUCHGO_ENABLED=0 (master),
  # ORB_TOUCHGO_RULE_M_THRESH=0.4 etc.
  touchgo:
    enabled: true
    rule_m:
      enabled: true
      threshold: 0.5
    rule_d:
      enabled: true
      revert_R: 0.75
      exit_R: -0.5
    # Which bar Rule M/D evaluate (2026-06-04 fix):
    #   market = the MARKET breakout bar (first bar high>range_high) — BT-parity
    #            and robust to fill latency. DEFAULT.
    #   fill   = legacy: the minute of the fill (pre-fix; diverges from BT when
    #            stop-limit fills lag the breakout). Rollback only.
    # Env override: ORB_TOUCHGO_BREAKOUT_BAR_SOURCE=market|fill
    breakout_bar_source: market
    # Late-fill guard: skip touchgo if the fill landed more than this many
    # minutes after the market breakout bar (stale entry — no retroactive tag
    # exit). Env override: ORB_TOUCHGO_MAX_BREAKOUT_AGE_MIN
    max_breakout_age_min: 15
  features:
    gap_pct:
      sign: -1              # lower gap = better
      mean: 187.905162
      std: 1749.630103
    range_total_volume:
      sign: -1              # lower early volume = less exhausted
      mean: 1032481.678899
      std: 2236111.090560
    range_avg_bar_range_pct:
      sign: -1              # narrower bars = better breakout
      mean: 2.481485
      std: 1.721792
    range_size_pct:
      sign: -1              # tighter 5-min range = cleaner continuation
      mean: 6.304430
      std: 4.482915
    price_vs_20d_high_pct:
      sign: -1              # further from 20d high = fresher
      mean: 26.814918
      std: 339.841711
    prev_day_close_position:
      sign: -1              # prev closed low in range = less tired
      mean: 0.488915
      std: 0.303208
    range_close_position:
      sign: +1              # close high in range = real momentum
      mean: 0.580629
      std: 0.303179

# Quintile cutoffs on composite score (H1 2025 TRAIN kept, n=670).
# Used to assign Q1-Q5 bucket → feed adaptive mult.
quintile_cutoffs: [0.1082, 0.1959, 0.2893, 0.4081]

# Adaptive position-size multipliers per quintile — fit from H1 2025 TRAIN
# using the SHIPPED static_lock_1R exit (not the old fixed +2R/-1R simulation
# that produced the prior stale values).
# Q5 CAPPED at 1.5x (raw 2.462); Q2/Q3 floored at MIN_MULT=0.25 (raw below).
# Per-position impact: Q4 at 1.84x on a $25K cap → $46K Q4 position. Four Q4
# picks could deploy $184K, exceeding the $100K declared budget (paper BP
# is $200K so it fits, but this is the validated BT behavior — Q4 is the
# alpha bucket and the pipeline leans into it).
adaptive_mults:
  Q1: 0.502
  Q2: 0.250    # floored at MIN_MULT=0.25 (raw < 0.25)
  Q3: 0.250    # floored at MIN_MULT=0.25 (raw < 0.25)
  Q4: 1.842    # primary alpha bucket — sized aggressively
  Q5: 1.500    # CAPPED at 1.5 (raw 2.462 pre-cap)

# Ranking — Q4-preferred, then composite DESC.
# Q4 empirically best bucket across all 3 walk-forward splits.
ranking:
  order: [Q4, Q5, Q3, Q2, Q1]   # Q4 first, Q5 second, ...

# Correlation dedup — at most 1 pick per family AND 1 per super-group per day.
# Family + super-group definitions live in trading/orb_correlation.py (data module).
dedup:
  by_family: true
  by_super_group: true

# Sizing — risk-parity within per-position cap.
sizing:
  account_budget_usd: 100000    # ORB's carved pool (shared account later)
  max_concurrent: 4             # top-N picks per day
  risk_per_trade_usd: 3000      # validated value; lower to $1000 for Phase 2 live ramp
  min_stop_pct: 1.0             # floor on stop distance (% of entry) to prevent inf sizing
  old_position_reference_usd: 50000  # BT base for _rp_scale math — do not change

# Exit — static_lock_1R pattern.
# Initial stop = range_low. After price touches +1.5R, stop pinned at +1R (never moves).
# No hard target — hold to force_close or lock exit if price retraces.
exit:
  stop_mode: range_low
  # 2026-05-08 BT: 1.75R/0.50R Pareto-dominates 1.5R/1.0R on HOLDOUT —
  # +$22K P&L (+24%), better Sharpe/Sortino/win-rate/worst-week. See README.
  lock_arm_at_r: 1.75           # arm lock when bar high reaches entry + 1.75 * range_size
  lock_stop_r: 0.5              # stop level after lock armed (entry + 0.5R)
  force_close_time_et: "15:45"  # matches bull flag + MACD wave policy
  exit_slip_bps: 10             # calibrated from live exit telemetry

# Safety-net bracket stop-loss sent to Alpaca (wide, backup if service crashes).
# Real stop is monitored client-side via StopMonitor; this fires only in disaster cases.
safety_net:
  sl_pct: 0.10                  # 10% below entry — wider than MACD's 5% because ORB stops are wider

# Risk management
risk:
  daily_loss_limit_usd: -5000   # once hit, skip new entries for the day
  max_consecutive_losing_days: 0  # 0 = disabled (we tested and it didn't help on OOS)

# Cross-strategy conflict: FCFS — skip if any strategy has symbol open today.
conflict:
  skip_if_any_strategy_has_symbol: true

# Telegram notifications
notifications:
  telegram:
    prefix: "[ORB]"
    notify_on_startup: true
    notify_on_entry: true
    notify_on_exit: true
    notify_on_spread_skip: true      # warn when we skip due to > max_spread_bps
    notify_on_capital_exhausted: true
    notify_on_daily_loss_limit: true
    notify_on_filter_skip: false     # too noisy — most candidates don't qualify
    notify_on_force_close: true

    # Force-close verify/retry tunables (2026-05-07 hardening; ASTX 5/6
    # post-mortem). The engine-state and orphan-sweep passes submit close
    # orders. After that, the verify pass polls Alpaca to confirm the
    # account is flat; if any position survives, we re-close + re-verify
    # up to retry_count times with backoff. Defaults are sized for typical
    # Alpaca paper ACK latency and the 15-minute window between
    # force_close_time_et and 16:00 ET market close. Override only when
    # reproducing failures locally / running tests.
    force_close_verify:
      max_wait_s: 10        # poll up to 10s for position to clear
      poll_interval_s: 1.0  # query Alpaca every 1s during the wait
      retry_count: 3        # full verify+re-close cycles before CRITICAL alert
      retry_backoffs_s: [5, 10, 15]  # sleep between retries (size = retry_count - 1 used)

# Slippage model for reference (matches BT assumptions). Production uses entry_slip_bps + exit_slip_bps above.
slippage:
  entry_pct: 0.003   # 30bps — validate in Phase 1 paper
  exit_pct: 0.001    # 10bps — validate in Phase 1 paper
