# MACD Wave Strategy Configuration
# Separate from bull flag config — independent strategy

strategy:
  name: macd_wave
  enabled: true

# Universe filters (applied to daily bars to find candidates)
universe:
  min_price: 5.0            # Original validated run included $5-15 stocks (FLYE $5.16, BTTC $13.65 = $60K P&L)
  max_price: 30.0           # Validated: >$30 kills WR, >$50 loses money
  min_daily_volume: 500000  # Previous-day volume floor (1M kills strategy, 500K is sweet spot: 47% WR, +$230K)
  min_dollar_volume: 3000000  # Min daily dollar volume — filters untradeable micro-caps
  min_intraday_pct: 10.0

# Entry filters (applied at the +threshold% cross point)
entry:
  cross_time_max_min: 10    # Max minutes after open for MACD cross entry
  min_vol_at_cross: 0       # 0 = disabled
  max_vol_at_cross: 300000  # Validated: >300K = crowded
  min_macd_hist_pct: 0.5    # Validated: MACD hist >= 0.5% of price
  max_price_at_entry: 30    # Match universe max
  # Smart entry: L1-informed pricing + early entry on strong book
  smart_entry_enabled: true   # Smart PRICING enabled (spread-aware limits)
  early_entry_bars: 3         # DISABLED: set to confirm_bars (3) = no early entry until backtested
  early_bid_ask_ratio: 2.0    # bid_sz/ask_sz required for early entry
  early_max_spread_pct: 0.003 # max spread for early entry (0.3%)
  normal_bid_ask_ratio: 1.5   # for 2nd bar entry
  normal_max_spread_pct: 0.005 # for 2nd bar entry (0.5%)

# MACD indicator parameters
macd:
  fast_period: 12
  slow_period: 26
  signal_period: 9
  confirm_bars: 3

# Wave management
waves:
  max_waves: 1              # Max waves to trade per stock per day
  w1_scout: false           # If true, W1 is paper-only, trade W2+ after qualified W1
  w1_min_pct: 5.0           # If w1_scout, minimum W1 gain % to qualify for W2+

# Position sizing
sizing:
  position_size: 50000      # $ per position
  max_concurrent: 5         # Max simultaneous open positions
  max_adv_participation_pct: 0  # Disabled — waiting for real L2 depth data

# Slippage model — matched to production measurements (0.54% avg entry, ~0.2% exit)
slippage:
  entry_pct: 0.005          # 0.5% — production avg on buy-stop/limit fills
  exit_pct: 0.002           # 0.2% — blend of stop exits (0.3%) and clean exits (~0%)

# Risk management
risk:
  hard_stop_pct: 0.02       # 2% hard stop loss per trade (crash protection)
  trail_stop_pct: 0.002     # 0.2% trail (Phase B2: tightened from 0.3% at realistic 0.5% slip — improved both Q1 25 +$2.7K and Q1 26 +$3.5K)
                             # Prior 0.3% validated at 0.1% slip fantasy: 48% WR, +$260K, 13/15 green months
                             # Without trail: 30% WR, lottery-dependent
  daily_loss_limit: -5000
