# Alpaca API Configuration (main account — bull flag + MACD wave)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Alpaca ORB paper account (Phase 1 validation only — separate from main account)
# Leave blank until ready to enable ORB strategy in paper mode.
ALPACA_ORB_API_KEY=
ALPACA_ORB_API_SECRET=
ALPACA_ORB_PAPER=true

# Anthropic API (optional - enables LLM news analysis with Claude Haiku 4.5)
ANTHROPIC_API_KEY=
