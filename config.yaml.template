log_level: INFO
orphan_reconciler:
  auto_close_enabled: true
  lookback_days: 14
  avg_entry_match_pct: 0.0005
  avg_entry_match_abs_min: 0.005
  max_closes_per_hour: 3
  alert_cooldown_minutes: 60
scanner:
  price_min: 1.0
  price_max: 30
  float_max: 50000000
  min_daily_volume: 200000
  min_dollar_volume: 0
  gap_pct_min: 2.0
  intraday_change_pct_min: 15.0
  require_news: false
  relative_volume_min: 0
  volume_profile_days: 50
timing:
  premarket_poll_interval: 60
  intraday_scan_interval: 15
  premarket_start: 04:00
  market_open: 09:30
  market_close: '16:00'
database:
  cache_path: data/cache.db
  trades_path: data/trades.db
float_cache:
  refresh_days: 7
news_analyzer:
  model: claude-haiku-4-5-20251001
notifications:
  telegram:
    enabled: true
    send_on_startup: true
    send_on_qualified: false
    send_on_pattern: true
    send_on_trade: true
    send_on_close: true
    send_daily_report: true
trading:
  enabled: true
  sizing_mode: fixed_risk
  capital: 50000
  risk_per_trade: 2000
  position_size_dollars: 50000
  max_shares: 15000
  bt_buying_power_usd: 200000
  max_adv_participation_pct: 0.02
  max_bar_participation_pct: 0
  max_positions: 7
  daily_loss_limit: -5000.0
  min_risk_pct: 0.01
  max_risk_pct: 0.04
  min_risk_reward: 2.5
  min_price: 2.0
  min_stop_distance: 0.09
  last_entry_time: '10:45'
  force_close_time: '15:45'
  setup_expiry_bars: 10
  pattern_poll_interval: 5
  skip_midday: false
  skip_fridays: false
  max_consecutive_losses: 0
  risk_tiers:
    enabled: true
    tier1_min_price: 10.0
    tier1_max_price: 15.0
    tier1_min_volume: 500000
    tier1_max_volume: 5000000
    tier1_multiplier: 2.0
    tier2_min_price: 15.0
    tier2_max_price: 23.0
    tier2_min_volume: 500000
    tier2_max_volume: 5000000
    tier2_multiplier: 1.0
  max_trades_per_day: 5
  market_regime:
    enabled: true
    vol_threshold: 5.0
    sma_period: 50
    min_spy_volume_ratio: 0.7
    thin_liquidity_breakout_vol_ratio: 2.0
    sma_slope_filter: false
    sma_slope_threshold: -0.5
    euphoria_filter: false
    euphoria_ud_threshold: 1.2
    euphoria_rsi_threshold: 60.0
  regime_sizing:
    enabled: true
    vol_threshold_pct: 22.0
    slope_threshold_pct: 0.15
    multipliers:
      A: 1.25
      B: 1.0
      C1: 1.5
      C2: 0.0
  ud_risk_scaling:
    enabled: true
    ud_threshold: 1.2
    scale_factor: 0.5
  spy_macd_cutoff:
    enabled: false
    cutoff_time: '11:30'
  self_managed_stops:
    enabled: true
    safety_net_sl_pct: 0.05
    marketable_limit_offset: 0.03
    marketable_limit_offset_pct: 0.005
    exit_min_offset: 0.01
    exit_spread_offset_factor: 0.3
  trailing_stop:
    enabled: true
    trail_r: 1.0
    activate_at_r: 2.0
    tighten_at_r: 0
    tightened_trail_r: 0.5
    vol_confirmed_exit:
      enabled: true
      min_vol_ratio: 1.0
  post_fill_gate:
    enabled: true
    spy_3d_threshold: 0.5
    bk_ratio_threshold: 0.5
  marketable_limit_fallback:
    enabled: true
    rebump_buffer: 0.02
  exhaustion_exit:
    enabled: true
    partial_fraction: 0.5
    tighter_trail_r: 0.5
    min_profit_r: 3.0
    signals:
      volume_divergence: false
      climax_candle: true
      shrinking_bodies: false
      shooting_star: true
  entry_slippage_pct: 0.005
  exit_slippage_pct: 0.003
  bull_flag:
    min_pole_candles: 3
    min_pole_gain_pct: 3.0
    max_retracement_pct: 50.0
    max_pullback_candles: 10
    min_breakout_volume_ratio: 1.5
    require_macd_positive: false
    max_green_in_flag: 2
    max_pole_bars: 3
    two_tier_filter:
      enabled: true
      extras_lower: 10.0
      a_tier_lower: 20.0
      drop_extras_macd_below: 1.25
      composite_threshold: -0.5
      composite_features:
        conviction_mult:
          mean: 1.789
          std: 0.284
          sign: -1
        qf_vwap_dist_pct:
          mean: 4.218
          std: 2.239
          sign: -1
        qf_fill_vwap_dist_pct:
          mean: 4.604
          std: 2.274
          sign: -1
        entry_minute:
          mean: 603.614
          std: 20.195
          sign: -1
  macd_zones:
    enabled: true
    dead_zone_min_pct: -0.2
    dead_zone_max_pct: 0.1
    strong_neg_threshold_pct: -0.5
    strong_pos_threshold_pct: 0.5
    strong_neg_multiplier: 1.8
    strong_pos_multiplier: 1.8
    normal_multiplier: 1.0
    extras_tier:
      normal_multiplier: 0.0
      strong_pos_multiplier: 2.0
      strong_neg_multiplier: 2.0
  quality_filter:
    enabled: false
    max_vwap_distance_pct: 6.0
    gap_fade_threshold_pct: 15.0
    min_spy_return_pct: -0.3
    slow_pole_max_bars: 15
    slow_pole_min_gain_pct: 5.0
  conviction_scoring:
    enabled: true
    min_threshold: 1.8
    v_reversal_bonus:
      enabled: true
      bonus: 1.0
      gap_pct_max: 0.0
      intraday_range_min: 20.0
      pole_gain_min: 5.0
    marginal_scaling:
      enabled: false
      scale_factor: 0.5
      upper_bound: 1.7
  news_gate:
    enabled: false
  news_kill_rules:
    enabled: true
    catalyst_exemption: false
    max_avg_vol_no_news: 3000000
    min_price_no_news: 3.0
    max_float_no_news: 30000000
ignition_shadow:
  enabled: true
  trigger_pct: 10.0
  max_trigger_min_et: 630
  min_r_pct: 5.0
  gap_max_pct: 5.0
  min_cohort: 2
  max_evals_per_day: 25
